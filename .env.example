# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Required in production: random secret, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# PostgreSQL (the only supported database). Use ONE of the two forms:
#   1) a single URL (special characters in the password must be percent-encoded)
DATABASE_URL=postgresql://magical_user:CHANGE_ME@127.0.0.1:5432/magical_web
#   2) or individual settings (leave DATABASE_URL empty/commented out)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=magical_web
# PGUSER=magical_user
# PGPASSWORD=
# DATABASE_SSL=false             # true for managed databases that require TLS
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# PG_POOL_MAX=10
# DB_AUTO_MIGRATE=true           # set false to apply migrations only via `npm run migrate`

# Tests ONLY. Must be a different, empty database whose name ends in "_test"; its tables are wiped by the tests.
TEST_DATABASE_URL=postgresql://magical_user:CHANGE_ME@127.0.0.1:5432/magical_web_test

# Built frontend directory served by the Node server
STATIC_DIR=dist

# Set true when served over HTTPS (default in production). Adds the Secure flag to the admin and Pioneer Card
# login cookies. It does NOT enable HSTS.
COOKIE_SECURE=true
# Strict-Transport-Security (max-age=1 year, includeSubDomains). Sent only when exactly "true"; off by default,
# also in production. Browsers keep it for a year for magical.am AND every subdomain, so enable it only once every
# subdomain that is (or will be) used serves valid HTTPS.
HSTS_ENABLED=false
# Set true only when behind a reverse proxy (nginx, Caddy) that sets X-Forwarded-For
TRUST_PROXY=false
# Extra allowed browser origins (comma separated), e.g. https://magical.am. Same-origin needs nothing.
ALLOWED_ORIGINS=
SESSION_TTL_HOURS=8

# Pioneer Card
# Cardholder session lifetime in hours (1-72, default 4).
PIONEER_SESSION_TTL_HOURS=4
# Recommended: random secret (32+ chars) mixed into every CVV hash, so a database dump alone cannot be used
# to test the 1000 possible CVVs offline. Set it BEFORE creating cards; changing it later makes every CVV
# stop working (each card then needs "Reset CVV" in the admin panel).
PIONEER_CVV_PEPPER=

# Integration API (/api/integration/v1, docs/PIONEER_CARD_API.md). API keys are NOT configured here: create them
# with `npm run integration -- create-key --name <partner>`; only their hash is stored in the database.
# Refuse plain-HTTP integration requests (default: true in production; needs TRUST_PROXY=true behind nginx/Caddy).
# INTEGRATION_REQUIRE_HTTPS=true

# Used only by `npm run seed:admin` (initial administrator). Remove the password from .env afterwards.
ADMIN_USERNAME=magical
ADMIN_PASSWORD=
